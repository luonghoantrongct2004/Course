@model EduCourse.Entities.StudentExam

@{
    ViewData["Title"] = "Chi tiết bài thi";
    int totalCorrect = Model.ExamDetails.Count(x => x.Result == "Correct");
    int totalIncorrect = Model.ExamDetails.Count(x => x.Result == "Incorrect");
    int totalPartiallyCorrect = Model.ExamDetails.Count(x => x.Result == "Partially Correct");
}
<style>
    .wrong {
        background-color: #ffb1b1;
        color: #324fa2;
    }

    .correct {
        background-color: #80d9a3;
        color: #324fa2;
    }

    .form-check-label {
        color: black;
    }

    .form-check-input:disabled {
        pointer-events: none;
        filter: none;
        opacity: 1;
    }

        .form-check-input:disabled ~ .form-check-label, .form-check-input[disabled] ~ .form-check-label {
            cursor: default;
            opacity: 1;
        }
</style>

<link rel="stylesheet" href="~/assets/plugins/boxicons/css/boxicons.min.css">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="p-5 bg-white rounded-lg">
    <div id="step-1" class="form-step">
<div class="p-6">
    <div class="flex flex-col justify-between gap-5 mb-6 sm:flex-row">
        <div>
            <h3 class="mb-1 text-xl font-semibold leading-6 text-slate-800">
                Chi tiết bài thi
            </h3>
        </div>
        <div>
                    <a href="/admin/exam/studentexam"
               class="flex items-center px-4 py-3 text-sm text-white rounded-lg shadow-xs gap bg-primary">
                <svg width="24"
                     height="24"
                     viewBox="0 0 24 24"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 11H9L12.29 7.71C12.3837 7.61704 12.4581 7.50644 12.5089 7.38458C12.5597 7.26272 12.5858 7.13201 12.5858 7C12.5858 6.86799 12.5597 6.73728 12.5089 6.61542C12.4581 6.49356 12.3837 6.38296 12.29 6.29C12.1026 6.10375 11.8492 5.99921 11.585 5.99921C11.3208 5.99921 11.0674 6.10375 10.88 6.29L6.59 10.59C6.21441 10.9633 6.00223 11.4704 6 12C6.00487 12.5261 6.21684 13.0291 6.59 13.4L10.88 17.7C10.9732 17.7926 11.0838 17.8659 11.2054 17.9157C11.3269 17.9656 11.4571 17.991 11.5885 17.9906C11.7199 17.9901 11.8499 17.9638 11.9712 17.913C12.0924 17.8623 12.2024 17.7882 12.295 17.695C12.3876 17.6018 12.4609 17.4912 12.5107 17.3696C12.5606 17.2481 12.586 17.1179 12.5856 16.9865C12.5851 16.8551 12.5588 16.7251 12.508 16.6038C12.4573 16.4826 12.3832 16.3726 12.29 16.28L9 13H19C19.2652 13 19.5196 12.8946 19.7071 12.7071C19.8946 12.5196 20 12.2652 20 12C20 11.7348 19.8946 11.4804 19.7071 11.2929C19.5196 11.1054 19.2652 11 19 11Z"
                          fill="currentColor" />
                </svg>
                Trở về
            </a>
        </div>
    </div>
    <div class="p-5 bg-white rounded-lg">
                <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
                    <div class="border-b border-slate-200 col-span-full">
                        <h3 class="mb-2 text-xl font-semibold leading-6 text-mainblack">
                            Thông tin bài thi
                        </h3>
                        <span asp-validation-summary="All" class="text-red"></span>
                    </div>

                    <div class="col-span-full p-4 bg-white rounded-lg shadow-lg border border-slate-200">
                        <h3 class="mb-4 text-lg font-semibold text-mainblack">Thông tin bài thi</h3>

                        <p class="mb-2 text-sm font-medium text-mainblack">
                            <strong>Tiêu đề bài thi:</strong> @Model.Exam?.Title
                        </p>

                        <p class="mb-2 text-sm font-medium text-mainblack">
                            <strong>Ngày thi:</strong> @Model.ExamDate.ToString("dd/MM/yyyy hh:mm")
                        </p>

                        <p class="mb-2 text-sm font-medium text-mainblack">
                            <strong>Điểm tổng cộng:</strong> @Model.Score
                        </p>

                        <p class="mb-2 text-sm font-medium text-mainblack">
                            <strong>Tổng câu đúng:</strong> @totalCorrect
                        </p>

                        <p class="mb-2 text-sm font-medium text-mainblack">
                            <strong>Tổng câu gần đúng:</strong> @totalPartiallyCorrect
                        </p>

                        <p class="mb-2 text-sm font-medium text-mainblack">
                            <strong>Tổng câu sai:</strong> @totalIncorrect
                        </p>
                    </div>


                    <!-- Loop through each question and display it in a card layout -->
                    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2 col-span-full">
                        @foreach (var detail in Model.ExamDetails)
                        {
                            var resultClass = detail.Result == "Correct" ? "bg-success text-white"
                            : detail.Result == "Partially Correct" ? "bg-warning text-dark"
                            : "bg-danger text-white";

                            <div class="p-4 rounded-lg shadow-lg border border-slate-200 @resultClass">
                                <!-- Question Content -->
                                <div class="mb-4">
                                    <label class="block text-sm font-medium leading-6 text-mainblack">Câu hỏi:</label>
                                    <p class="text-mainblack">@detail.Question?.Content</p>
                                </div>

                                <!-- Answer Options -->
                                <div class="flex flex-col gap-2">
                                    @if (detail.QuestionType == "Single Choice")
                                    {
                                        <ul>
                                            @foreach (var option in detail.Question.Options)
                                            {
                                                var isSelected = detail.SelectedAnswers.Contains(option.OptionID);
                                                var isCorrect = option.IsCorrect == true;

                                                <li class="mb-2">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="single-choice-@detail.Question.QuestionID" @(isSelected ? "checked" : "") disabled>
                                                        <label class="form-check-label @(isCorrect ? "text-success" : "")">
                                                            @option.Content
                                                        </label>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else if (detail.QuestionType == "Multiple Choice")
                                    {
                                        <ul>
                                            @foreach (var option in detail.Question.Options)
                                            {
                                                var isSelected = detail.SelectedAnswers.Contains(option.OptionID);
                                                var isCorrect = option.IsCorrect == true;

                                                <li class="mb-2">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" @(isSelected ? "checked" : "") disabled>
                                                        <label class="form-check-label @(isCorrect ? "text-success" : "")">
                                                            @option.Content
                                                        </label>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else if (detail.QuestionType == "Keyword")
                                    {
                                        <p><strong>Đáp án từ khóa:</strong> @string.Join(", ", detail.SelectedAnswers)</p>
                                    }
                                </div>
                            </div>
                        }

                    </div>
                </div>

    </div>
    </div>
    </div>
